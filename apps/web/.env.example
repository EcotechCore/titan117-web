# apps/web: copy to .env.local (git-ignored) and fill in. Never commit real values.

# Convex dev deployment: the CONVEX_URL from packages/backend/.env.local
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (customer application), from Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe (test mode while building), from Stripe dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen` while testing webhooks locally
STRIPE_WEBHOOK_SECRET=whsec_...
