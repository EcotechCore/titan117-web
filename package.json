{
  "name": "titan117-web",
  "private": true,
  "type": "module",
  "description": "Titan117 web app, Convex backend and @titan117/shared.",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
